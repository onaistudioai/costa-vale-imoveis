# Postgres (Neon). O checkpointer do LangGraph usa a mesma conexão — é ele que
# implementa o lock por imóvel (R2), então não aponte pra um banco efêmero.
#
# `verify-full` não é enfeite: sem ele o tráfego vai cifrado mas o servidor não
# é autenticado, e quem estiver no caminho lê a conexão inteira.
DATABASE_URL=postgresql://user:senha@host/db?sslmode=verify-full&channel_binding=require

# Modelos (Groq). Só os Agentes 1, 2 e 4 consomem — o Agente 3 é
# determinístico e não chama modelo nenhum.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Opcional: rastreio do grafo
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false

# Segredo do webhook `POST /api/eventos` e de `/api/varredura`. Sem nenhum dos
# dois segredos, as rotas recusam tudo com 401 — é o padrão seguro: canal, CRM
# e formulário de laudo entram todos por ali.
WEBHOOK_SECRET=

# O mesmo poder, pela forma que o Vercel Cron sabe usar:
# `Authorization: Bearer $CRON_SECRET`. Existe pra que o segredo não precise ir
# na URL, que é onde ele acabaria em log de acesso.
CRON_SECRET=

# Canal de saída (WhatsApp). Aponta para um bridge HTTP que exponha
# POST /api/send com { recipient, message }.
# VAZIO = nada sai, tudo vai pro log. É assim que o projeto roda hoje.
WHATSAPP_BRIDGE_URL=

# Para onde vai o alerta de pedido urgente (faixa vermelha): número ou grupo da
# equipe, no mesmo formato do bridge acima. Só a faixa vermelha dispara — se
# toda linha avisasse, em uma semana ninguém leria mais o aviso.
# VAZIO = nada sai, o alerta vai pro log e fica registrado em mensagem_enviada.
WHATSAPP_EQUIPE=

# --- E-mail: o canal que guarda ---
# O WhatsApp chama, o e-mail guarda. Faixa vermelha dispara os dois; amarela
# manda só o e-mail, porque a proposta da revisão merece leitura calma e não
# vale interromper ninguém por ela.
#
# O e-mail leva o caso trabalhado (custo, etapa, o que a revisão achou, link) e
# NUNCA nome, telefone ou a fala do cliente — isso fica no painel, que tem
# login. A seleção é lista de permissão, em src/lib/alerta.ts.
#
# VAZIO = nada sai; o texto vai pro log e fica registrado em mensagem_enviada,
# que é como se confere o conteúdo antes de existir domínio verificado.
RESEND_API_KEY=
# Um ou vários, separados por vírgula.
EMAIL_EQUIPE=
# Precisa ser de domínio verificado no provedor, senão ele recusa.
EMAIL_REMETENTE=

# Endereço público do painel, usado pra montar o link do e-mail. Sem isso o
# e-mail sai dizendo só "abra o painel".
PAINEL_URL=

# Acesso somente-leitura, usado só pelo agente de consulta. É o mesmo banco com
# um papel que só tem SELECT — relatório não deve poder escrever nada. Desde a
# migração 0011 o RLS também esconde dele a trilha de auditoria e o histórico
# de mensagens.
#
# VAZIO = a aplicação NÃO SOBE. Antes ela caía na conexão com poder de escrita
# e deixava um aviso no log, que é a forma de uma garantia sumir sem ninguém
# notar.
DATABASE_URL_LEITURA=

# Quem abre o painel. Gere com: npm run acesso -- <nome> [outro-nome]
# Formato: nome:sal:hash,nome:sal:hash — nunca a senha em texto puro. O hash é
# `scrypt` com sal por pessoa; o formato antigo `nome:hash` não é aceito.
# Vazio = painel fechado (503). Aberto por falta de configuração seria pior.
PAINEL_USUARIOS=

# --- Criptografia da PII ---
# CPF, telefone, e-mail e o identificador de canal ficam cifrados no banco. As
# duas chaves têm 32 bytes em hex e são DIFERENTES entre si — a do índice é
# determinística por natureza e não pode cifrar nada.
#
# Gere cada uma com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# PERDER A PII_KEY É PERDER OS DADOS. Não há recuperação, é esse o ponto.
PII_KEY=
PII_INDEX_KEY=

# Banco dos testes — NUNCA o mesmo do painel.
# A suíte de integração apaga tabelas inteiras a cada teste. No Neon, crie um
# branch (leva segundos e copia o schema) e ponha a URL dele aqui.
# Vazio = os testes de integração se marcam como pulados, e nada é apagado.
TEST_DATABASE_URL=
# O mesmo branch, pelo papel que só tem SELECT — é o que mantém de pé o teste
# que prova que o relatório não consegue escrever.
TEST_DATABASE_URL_LEITURA=
